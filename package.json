{
  "name": "divinekart",
  "version": "1.0.0",
  "private": true,
  "description": "DivineKart — Hindu Religious & Spiritual Ecommerce Platform (Monorepo)",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "seed": "pnpm --filter divinekart-backend run seed",
    "db:migrate": "pnpm --filter divinekart-backend run db:migrate",
    "test:e2e": "playwright test",
    "agent:run": "node .agents/autonomous/driver.mjs run",
    "agent:discover": "node .agents/autonomous/driver.mjs discover",
    "agent:recover": "node .agents/autonomous/driver.mjs recover",
    "agent:release": "node .agents/autonomous/driver.mjs release",
    "agent:next-version": "node scripts/dev/next-version.mjs",
    "agent:test": "node --test .agents/autonomous/test/"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
"fallow": "^3.15.0",
    "turbo": "^2.10.11"
  }
}
